# Copy this file to .env and fill in the values. Never commit .env.

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGODB_URI=
MONGODB_DB=mentorthena

# Gemini API key from Google AI Studio
GEMINI_API_KEY=

# 1 = call Gemini for hints (testing, demo). 0 = free backup hints only, zero Gemini requests (building the UI).
USE_GEMINI=1
